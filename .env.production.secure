# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this to .env for production deployment

APP_NAME="Cloth.Ai"
APP_ENV=production
APP_KEY=base64:TRV0e7EttH9pobh5q+BLNQszt+RT4Rq6gw3ee++mQT8=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# SECURITY SETTINGS
BCRYPT_ROUNDS=12
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# PRODUCTION RAZORPAY CREDENTIALS (Replace with your live keys)
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_LIVE_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# PRODUCTION LOGGING
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=30

# PRODUCTION DATABASE
DB_CONNECTION=mysql
DB_HOST=your-production-db-host
DB_PORT=3306
DB_DATABASE=your_production_database
DB_USERNAME=your_secure_db_user
DB_PASSWORD=your_secure_db_password

# PRODUCTION CACHE & PERFORMANCE
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis

# REDIS CONFIGURATION
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# PRODUCTION MAIL
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# SECURITY MONITORING
MAIL_ADMIN_EMAIL=admin@yourdomain.com

# FILESYSTEM
FILESYSTEM_DISK=public

# AWS (Optional - for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"